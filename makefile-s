##############################################################################
################################ makefile-s ##################################
##############################################################################
#                                                                            #
#   makefile of BranchAndXSolver and its dependencies, excluding SMS++       #
#									     #
#   The makefile defines internally all external libraries required by       #
#   BranchAndXSolver, exluding the SMS++ core ones whose symbols are assumed #
#   to have been defined already (typically by including SMS++/lib/makefile).#
#   Accordingly, all necessary OBJ, H, -I directives, external libraries     #
#   + -L<libdirs> are added to the corresponding BAXSLV* macros.             #
#   complete makefile of BranchAndXSolver                                    #
#                                                                            #
#   Input:  $(CC)        = compiler command                                  #
#           $(SW)        = compiler options                                  #
#           $(SMS++INC)  = the -I$( core SMS++ directory )                   #
#           $(SMS++OBJ)  = the core SMS++ library                            #
#           $(BAXSLVSDR) = the directory where BranchAndXSolver source is    #
#           $(BAXSLVODR) = the directory where the objects have to be put    #
#                                                                            #
#   Output: $(BAXSLVOBJ) = the final object(s) / library                     #
#           $(BAXSLVLIB) = external libraries + -L<libdirs>                  #
#           $(BAXSLVH)   = the .h files to include for BranchAndXSolver      #
#           $(BAXSLVINC) = the -I$( BranchAndXSolver directory )             #
#                                                                            #
#                                VERSION 0.0                                 #
#                               25 - 05 - 2022                               #
#                                                                            #
#                              Antonio Frangioni                             #
#                             Federica Di Pasquale                           #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I<include directories>

# include the makefile requiring all external modules in input
include $(BAXSLVSDR)/makefile

# macroes to be exported- - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external stuff defined in the other makefiles to BAXSLVOBJ,
# BAXSLVINC and BAXSLVH, thus the := assignment has to be used (use GNU make)
BAXSLVOBJ := $(BAXSLVOBJ) 
BAXSLVINC := $(BAXSLVINC) 
BAXSLVH := $(BAXSLVH) 

# external libreries for BranchAndXSolver
BAXSLVLIB = 

########################### End of makefile-s ################################
